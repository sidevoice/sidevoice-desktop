{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "S0 Spike",
  "version": "0.0.1",
  "identifier": "ai.sidevoice.spike",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run web",
    "beforeDevCommand": "npm run web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
