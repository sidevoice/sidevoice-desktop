{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "main",
  "description": "The app's window shows only the interface bundled in the app (its own pages). It may use the app's model engine and run the voice call the app runs itself (host.engine, host.voice), read and request the app's microphone permission or open its page of the system's settings (host.microphone), and read and write the pairings the app keeps for it (host.pairings), all through the shared plugin sidevoice-shared-tauri (its ACL.md), and report the call to the app with its page's number (call_page, call_state), and ask for the screen to stay on during the call (keep_screen_on). Not the call's levels (bridge-level, bridge-playback): they feed the desktop's call controls card, which this app has none of. Nothing else.",
  "windows": ["main"],
  "permissions": [
    "allow-call-page",
    "allow-call-state",
    "allow-keep-screen-on",
    "sidevoice-shared-tauri:allow-engine-cancel",
    "sidevoice-shared-tauri:allow-engine-capabilities",
    "sidevoice-shared-tauri:allow-engine-catalogs",
    "sidevoice-shared-tauri:allow-engine-has-credential",
    "sidevoice-shared-tauri:allow-engine-install",
    "sidevoice-shared-tauri:allow-engine-installed",
    "sidevoice-shared-tauri:allow-engine-memory",
    "sidevoice-shared-tauri:allow-engine-progress",
    "sidevoice-shared-tauri:allow-engine-refresh",
    "sidevoice-shared-tauri:allow-engine-set-credential",
    "sidevoice-shared-tauri:allow-engine-test-credential",
    "sidevoice-shared-tauri:allow-engine-uninstall",
    "sidevoice-shared-tauri:allow-microphone",
    "sidevoice-shared-tauri:allow-pairings-read",
    "sidevoice-shared-tauri:allow-pairings-write",
    "sidevoice-shared-tauri:allow-voice-audio-devices",
    "sidevoice-shared-tauri:allow-voice-cancel-input",
    "sidevoice-shared-tauri:allow-voice-cancel-say",
    "sidevoice-shared-tauri:allow-voice-create-call",
    "sidevoice-shared-tauri:allow-voice-dispose-call",
    "sidevoice-shared-tauri:allow-voice-end-input",
    "sidevoice-shared-tauri:allow-voice-events",
    "sidevoice-shared-tauri:allow-voice-mute",
    "sidevoice-shared-tauri:allow-voice-preload",
    "sidevoice-shared-tauri:allow-voice-ready",
    "sidevoice-shared-tauri:allow-voice-route-input",
    "sidevoice-shared-tauri:allow-voice-say",
    "sidevoice-shared-tauri:allow-voice-set-audio-devices",
    "sidevoice-shared-tauri:allow-voice-start",
    "sidevoice-shared-tauri:allow-voice-stop",
    "sidevoice-shared-tauri:allow-voice-update"
  ]
}
