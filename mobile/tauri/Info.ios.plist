<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged by the Tauri CLI into the generated Info.plist. -->
<plist version="1.0">
<dict>
  <key>NSMicrophoneUsageDescription</key>
  <string>Sidevoice listens through the microphone so you can talk with your agent.</string>
  <key>NSLocalNetworkUsageDescription</key>
  <string>Sidevoice connects to your paired computer over the local network.</string>
  <key>NSCameraUsageDescription</key>
  <string>Sidevoice uses the camera to scan the pairing code your computer shows.</string>
  <!-- The three texts above are the English base. The other languages are mobile/tauri/ios/<language>.lproj/InfoPlist.strings,
       which `cargo xtask mobile generate ios` puts into the project; this list is the languages iOS offers the app in,
       the folders of mobile/tauri/ios (xtask tests that they agree). -->
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>de</string>
    <string>es</string>
    <string>fr</string>
    <string>it</string>
    <string>ja</string>
    <string>pl</string>
    <string>zh-Hans</string>
    <string>pt-BR</string>
    <string>ko</string>
    <string>hi</string>
  </array>
  <!-- A call goes on with the screen locked or another app in front: the audio session it holds keeps the app running
       while it records and plays (iOS has no service to start for it; docs/MOBILE.md). The call is a CallKit call, and
       CallKit takes one only from an app with the `voip` mode: without it every CXStartCallAction is refused as unentitled
       (com.apple.CallKit.error.requesttransaction, 1) and the call stays the app's own, with its Now Playing card on the
       lock screen. `cargo xtask mobile check-ios` checks both on the app as built. -->
  <key>UIBackgroundModes</key>
  <array>
    <string>audio</string>
    <string>voip</string>
  </array>
  <!-- The call's own Live Activity (Lock Screen and Dynamic Island, drawn by the SidevoiceActivity extension; docs/MOBILE.md →
       "The call's Live Activity"), and the app's links it opens: `sidevoice://conversations` (the stack of the other
       conversations: the app opens on its conversation list) and `sidevoice://call` (the rest of it). -->
  <key>NSSupportsLiveActivities</key>
  <true/>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>ai.sidevoice.mobile</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>sidevoice</string>
      </array>
    </dict>
  </array>
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
  <!-- Export compliance: the app uses no encryption beyond the system's (TLS in the web view is the system's) and
       hashing, so App Store Connect need not ask about it for each build. Revisit when native code brings its own
       (docs/MOBILE.md). -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
</dict>
</plist>
