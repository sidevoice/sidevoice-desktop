    <color name="call_card_lila">#FF4A2F6B</color>
    <color name="call_card_green_ink">#FF1D6B45</color>
    <color name="call_card_green">#FF1D6B45</color>
    <color name="call_card_warn_ink">#FF9A4A00</color>
    <color name="call_card_warn">#FF9A4A00</color>
    <color name="call_card_grey_ink">#FF545766</color>
    <color name="call_card_grey">#FF686B7A</color>
    <!-- Mute while off, and hang up: the same in both appearances. -->
    <color name="call_card_muted">#FFF9DEDC</color>
    <color name="call_card_muted_ink">#FF601410</color>
