<?xml version="1.0" encoding="utf-8"?>
<!-- The call's notification, collapsed (lower in the list): the face, "{title} · {state}", mute and hang up (HANDOVER §4
     "Android", spec/GEOMETRY.md "androidCollapsed"). The system draws the mark before it. Filled by CallCardViews.
     Only the title is cut: the state always shows whole. The line's own row is as wide as its words (wrap_content), at most
     the room left; when they don't fit, the title alone (its weight) gives the room back. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/call_card_face"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="8dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/call_card_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/dm_sans_700"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/call_card_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/call_card_line_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:fontFamily="@font/dm_sans_400"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="·"
                android:textColor="@color/call_card_text"
                android:textSize="14sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/call_card_line_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dm_sans_650"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/call_card_mute"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/call_card_button">

        <ImageView
            android:id="@+id/call_card_mute_icon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/call_card_hang_up"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/call_card_button_end">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_card_hang_up_white" />
    </FrameLayout>
</LinearLayout>
