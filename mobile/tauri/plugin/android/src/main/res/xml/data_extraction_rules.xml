<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup and device-to-device transfer on Android 12 and newer (API 31 and above); backup_rules.xml has the same
     rules for older versions, and the reasons. Both must carry them: a cloud backup and a transfer to a new phone are
     different channels. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="pairings/" />
        <exclude domain="sharedpref" path="keyring-sidevoice-providers.xml" />
        <exclude domain="file" path="models/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="pairings/" />
        <exclude domain="sharedpref" path="keyring-sidevoice-providers.xml" />
        <exclude domain="file" path="models/" />
    </device-transfer>
</data-extraction-rules>
