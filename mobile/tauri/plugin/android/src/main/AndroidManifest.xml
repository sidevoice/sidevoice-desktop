<?xml version="1.0" encoding="utf-8"?>
<!-- Merged by Gradle into the generated app's manifest, which this project never edits (design D.4, generator model
     G-a). The template sets usesCleartextTraffic to false in a release build; a network security config takes
     precedence over it. The template says nothing about backup (allowBackup stays at its default, true), so these two
     attributes merge in without a conflict: the pairings and the provider keys stay out of backups and transfers
     (res/xml/backup_rules.xml has why). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The call's service (CallService): it listens (microphone), the agent speaks (media playback) and it is a phone
         call (Telecom's), as a foreground service with a notification. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Without it, from Android 13 the notification is not shown (the service runs, and the system lists it). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The call is a self-managed call of the system's Telecom (Core-Telecom, CallService): a phone call the system, a
         Bluetooth or car kit and a watch show. MANAGE_OWN_CALLS is granted at install; the service is a phone call too
         (its foreground type), and gives the page's mute to the system's microphone mute (MODIFY_AUDIO_SETTINGS). -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- The camera only scans the pairing code (docs/MOBILE.md -> "Scanning the pairing code"), so no device is left out for
         lacking one: the barcode scanner plugin's manifest says its camera features are required, and these replace that.
         Its VIBRATE is not used. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" tools:replace="android:required" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-permission android:name="android.permission.VIBRATE" tools:node="remove" />

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">
        <service
            android:name="ai.sidevoice.mobile.plugin.CallService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback|phoneCall" />
    </application>
</manifest>
