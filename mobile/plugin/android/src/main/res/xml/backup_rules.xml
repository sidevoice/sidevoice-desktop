<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup on Android 11 and older (API 30 and below; Android 12 and newer read data_extraction_rules.xml
     instead). Two things stay out of a backup, so a restored app asks the person to pair and to type the provider keys
     again:
     - the pairings (mobile/src/pairings.rs): the folder `pairings/` in getFilesDir(), which holds the record
       (`pairings.json`, the access token to the person's computer) and nothing else. A rule on the folder covers what is
       in it, including the temporary file `.pairings.json.<random>` of a write that a kill interrupted, whose name no
       rule could give;
     - the SharedPreferences file of android-native-keyring-store (1.0.0) for the provider keys: `keyring-<store name>`,
       and the store is named `sidevoice-providers` (app-core/src/platform/credentials/android.rs). Its values are
       encrypted by a Keystore key that does not migrate, so they could not be decrypted on another phone anyway.
     Keep this file, data_extraction_rules.xml and the Rust names above in step. -->
<full-backup-content>
    <exclude domain="file" path="pairings/" />
    <exclude domain="sharedpref" path="keyring-sidevoice-providers.xml" />
</full-backup-content>
