<?xml version="1.0" encoding="utf-8"?>
<!-- Merged by Gradle into the generated app's manifest, which this project never edits (design D.4, generator model
     G-a). The template sets usesCleartextTraffic to false in a release build; a network security config takes
     precedence over it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The call's service (CallService): it listens (microphone) and the agent speaks (media playback), as a
         foreground service with a notification. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Without it, from Android 13 the notification is not shown (the service runs, and the system lists it). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application android:networkSecurityConfig="@xml/network_security_config">
        <service
            android:name="ai.sidevoice.mobile.plugin.CallService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback" />
    </application>
</manifest>
