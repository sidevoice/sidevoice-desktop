<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged by the Tauri CLI into the generated Info.plist. -->
<plist version="1.0">
<dict>
  <key>NSMicrophoneUsageDescription</key>
  <string>Sidevoice listens through the microphone so you can talk with your agent.</string>
  <key>NSLocalNetworkUsageDescription</key>
  <string>Sidevoice reaches your paired computer on the local network.</string>
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
  <!-- Export compliance: the app uses no encryption beyond the system's (TLS in the web view is the system's) and
       hashing, so App Store Connect need not ask about it for each build. Revisit when native code brings its own
       (docs/MOBILE.md). -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
</dict>
</plist>
