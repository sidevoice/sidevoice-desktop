node_modules/
/target/
desktop/tauri/gen/schemas/
# Held by desktop/tauri/build.rs while it regenerates the command permissions.
desktop/tauri/.build.lock
dist/
*.dmg
.DS_Store
# The web interface, the release web.pin.json names, fetched by scripts/build-web.mjs, and its download.
ui/voice/
ui/voice-browser/
ui/.web-site.json
target/web/
# cargo xtask: its build, and what its commands leave (target/xtask/, dmg-screens/, card-shots/, artifacts/, assets/).
xtask/target/
target/xtask/
dmg-screens/
card-shots/
/artifacts/
/assets/
# The mobile app: what `tauri icon` writes beside its sources (mobile/tauri/app-icon) besides the projects' own icons, and
# nothing reads.
mobile/tauri/icons/
mobile/tauri/gen/schemas/
# The engine's native libraries an app build packages (`cargo xtask mobile build`): sherpa-onnx's iOS xcframework and each
# target's binary (Android's go to mobile/tauri/gen/android/app/src/main/jniLibs, whose .so the project's own .gitignore ignores).
mobile/tauri/frameworks/
# The call's Live Activity package (mobile/tauri/apple/CallActivity): what SwiftPM and Xcode leave beside it.
mobile/tauri/apple/CallActivity/.build/
mobile/tauri/apple/CallActivity/.swiftpm/
# The Live Activity's Simulator harness (mobile/tauri/apple/Harness): the project XcodeGen makes of its spec, and the
# Info.plists and entitlements it writes.
mobile/tauri/apple/Harness/*.xcodeproj/
mobile/tauri/apple/Harness/Generated/
