{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "packaging/linux/icons/32x32.png",
      "packaging/linux/icons/64x64.png",
      "packaging/linux/icons/128x128.png",
      "packaging/linux/icons/128x128@2x.png",
      "packaging/linux/icons/icon.png",
      "packaging/macos/icon.icns",
      "packaging/windows/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "packaging/macos/Entitlements.plist",
      "infoPlist": "packaging/macos/Info.plist"
    }
  },
  "app": {
    "macOSPrivateApi": true
  }
}
