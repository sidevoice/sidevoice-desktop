<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime: the microphone is only reachable with this entitlement. Not sandboxed. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Apple events to Music and Spotify, to pause what plays while the microphone is open (docs/MEDIA_DUCK.md). -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
